+	def GateLightcallback(self,msg):
+		# Safety-gate status colour. ColorRGBA carries floats in 0..1; the
+		# board wants bytes. Alpha scales brightness so one colour can be
+		# shown dim (idle) or full (a verdict).
+		if not isinstance(msg, ColorRGBA): return
+		scale = msg.a if 0.0 <= msg.a <= 1.0 else 1.0
+		r = max(0, min(255, int(msg.r * scale * 255)))
+		g = max(0, min(255, int(msg.g * scale * 255)))
+		b = max(0, min(255, int(msg.b * scale * 255)))
+		self.car.set_colorful_lamps(0xFF, r, g, b)
