# Copy this file to .env and edit it. .env is ignored by git.
# A variable set in the shell wins over this file, so a one-off
#   LLM_BACKEND=ollama uvicorn host.server:app --port 8080
# overrides whatever is written here.

# Which model answers: anthropic (Claude, needs internet) or ollama (local, offline)
LLM_BACKEND=anthropic

# Claude through the Anthropic API — key from console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Local model through Ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434

# Which room: a folder under sites/ (map, places, forbidden zones).
# Default: demo for the in-memory robot, obyvak for the real one.
# SITE=obyvak

# Language the robot and the panel start in: en (default) or cs.
# The CZ / EN switch in the panel changes it until the next restart.
# ROBOT_LANG=cs
